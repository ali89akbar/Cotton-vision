# ============================================================
# PlantWise React client - environment template
# Copy to client/.env (CRA only reads variables prefixed REACT_APP_)
# ============================================================

# Base URL of the Express API. All auth calls (register / login /
# complete-profile) go here, and the axios interceptor attaches
# "Authorization: Bearer <token>" to requests aimed at this host only.
REACT_APP_API_URL=http://localhost:6005
