# ============================================================
# PlantWise API - environment template
# Copy to server/.env and fill in real values. Never commit .env.
# ============================================================

# --- Database ---
DATABASE=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# --- JWT (required for register / login / profile completion) ---
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset outside production a dev fallback is used and a warning is printed.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=10

# --- Express ---
PORT=6005
# NODE_ENV=production
SESSION_SECRET=replace-with-another-random-string

# --- CORS / OAuth redirects (comma separated for CLIENT_ORIGINS) ---
CLIENT_ORIGINS=http://localhost:3000,https://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ID=<google-oauth-client-id>
CLIENT_SECRET=<google-oauth-client-secret>

# --- Google Sign-In endpoints (defaults are fine for local development) ---
# Public URL of THIS API. The redirect URI is derived from it, and Google Cloud
# Console must list that URI verbatim under "Authorized redirect URIs".
PUBLIC_API_URL=http://localhost:6005
# GOOGLE_CALLBACK_URL=http://localhost:6005/auth/google/callback
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# Where the profile is read after the token arrives. Switch to
# https://www.googleapis.com/oauth2/v3/userinfo only if that host is reachable.
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# TLS is intercepted by your antivirus? Point this at its root CA bundle:
# NODE_EXTRA_CA_CERTS=C:\certs\antivirus-root-ca.pem

# --- AI + messaging providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API=
DASHSCOPE_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# --- Weather alert cron (OpenWeatherMap) ---
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Optional: cron expression (default "0 */4 * * *" runs every 4 hours)
# WEATHER_CRON_SCHEDULE=0 */4 * * *
# Optional: cooldown between duplicate alerts in ms (default 12 hours)
# WEATHER_ALERT_COOLDOWN_MS=43200000
